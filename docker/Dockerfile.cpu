FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/root/.cache/huggingface \
    PHONEMIZER_ESPEAK_LIBRARY=/usr/lib/x86_64-linux-gnu/libespeak-ng.so.1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# --------------------------------------------------
# System dependencies
# --------------------------------------------------

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    git \
    curl \
    wget \
    build-essential \
    ffmpeg \
    espeak-ng \
    libespeak-ng1 \
    && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------
# Node.js 22 LTS
# --------------------------------------------------

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && node --version \
    && npm --version \
    && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------
# Python 3.12
# --------------------------------------------------

RUN add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install \
        /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --install \
        /usr/bin/python python /usr/bin/python3.12 1

# --------------------------------------------------
# uv
# --------------------------------------------------

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# --------------------------------------------------
# Project
# --------------------------------------------------

WORKDIR /workspace

COPY . .

# --------------------------------------------------
# Install Python environment
# --------------------------------------------------

RUN uv sync --frozen --no-default-groups

# --------------------------------------------------
# Install crawler dependencies
# --------------------------------------------------

RUN if [ -f craw/package.json ]; then \
        cd craw && npm install --omit=dev; \
    fi

# --------------------------------------------------
# Runtime
# --------------------------------------------------

CMD ["/bin/bash"]